{
  "name": "opaline",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, open-source PostgreSQL workspace.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json",
    "lint": "eslint src tests --max-warnings 0",
    "format:check": "prettier --check src tests",
    "format": "prettier --write src tests",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "dev": "vite",
    "desktop:prepare": "node scripts/prepare-postgres.mjs",
    "desktop:dev": "npm run desktop:prepare && npm run dev",
    "desktop:build": "npm run desktop:prepare && npm run build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^1.41.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
